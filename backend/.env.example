PORT=3000
MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=your_jwt_secret_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Store settings (must match the frontend's VITE_CURRENCY_SYMBOL / VITE_DELIVERY_FEE)
STORE_NAME=Surprise Heaven
STORE_CURRENCY=usd
DELIVERY_FEE=10
FRONTEND_URL=http://localhost:5173

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx

# Razorpay (https://dashboard.razorpay.com/app/keys)
# Note: non-INR currencies require International Payments enabled on your Razorpay account
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email notifications (optional - any SMTP, e.g. Gmail with an App Password)
# Leave SMTP_HOST empty to log emails to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Surprise Heaven <you@gmail.com>"

# SMS notifications (optional - Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+94
